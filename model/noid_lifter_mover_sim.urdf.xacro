<?xml version="1.0"?>
<!-- Gazebo simulation variant of noid_lifter_mover.urdf.xacro
     (gz_ros2_control + sim mover with continuous wheels and lidar) -->
<robot name="SEED-Noid-Lifter-Mover" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="parts_dir" default="$(find noid_lifter_mover)/model/parts" />
    <xacro:arg name="controller_settings" default="$(find noid_lifter_mover)/config/controllers/controller_settings_gazebo.yaml" />

    <xacro:include filename="$(arg parts_dir)/typeg_lifter/typeg_lifter.xacro" />
    <xacro:include filename="$(arg parts_dir)/typeg_mover/typeg_mover_sim.xacro" />
    <xacro:include filename="$(arg parts_dir)/trx_s/trx_s_sim.xacro" />
    <xacro:include filename="$(arg parts_dir)/typeg_body/typeg_body.xacro" />
    <xacro:include filename="$(arg parts_dir)/typeg_larm/typeg_larm.xacro" />
    <xacro:include filename="$(arg parts_dir)/typeg_rarm/typeg_rarm.xacro" />

    <xacro:property name="robot_root" value="base_link" />
    <xacro:property name="lifter_bottom_link" value="lifter_bottom_link" />
    <xacro:property name="lifter_top_link" value="lifter_top_link" />
    <xacro:property name="mover_top_link" value="mover_top_link" />
    <xacro:property name="upper_base_link" value="waist_link" />

    <xacro:property name="larm_base_link" value="l_arm_link" />
    <xacro:property name="larm_tip_link" value="l_wrist_r_link" />
    <xacro:property name="lhand_base_link" value="l_hand_link" />

    <xacro:property name="rarm_base_link" value="r_arm_link" />
    <xacro:property name="rarm_tip_link" value="r_wrist_r_link" />
    <xacro:property name="rhand_base_link" value="r_hand_link" />


    <xacro:typeg-mover-sim
       base_link="${robot_root}"
       top_link="${mover_top_link}"/>

    <joint
       name="wheel_lifter_connector"
       type="fixed">
       <parent link="${mover_top_link}" />
       <child link="${lifter_bottom_link}" />
       <origin
          xyz="0.0 0.0 0.0"
          rpy="0 0 0 " />
    </joint>

    <xacro:typeg-lifter
       bottom_link="${lifter_bottom_link}"
       top_link="${lifter_top_link}" />

    <joint
       name="upper_lower_connector"
       type="fixed">
       <parent link="${lifter_top_link}" />
       <child link="${upper_base_link}" />
       <origin
          xyz="0.0 0.0 0.0"
          rpy="0 0 0 " />
    </joint>

    <xacro:typeg-body base_link="${upper_base_link}"/>

    <xacro:typeg-rarm base_link="${rarm_base_link}" tip_link="${rarm_tip_link}"/>


    <joint name="body_to_rarm_connector" type="fixed">
        <parent link="body_link" />
        <child link="${rarm_base_link}" />
        <origin xyz="-0.018 -0.134202 0.251871" rpy="0 0 0" />
    </joint>


    <joint name="r_wrist_to_hand_connector" type="fixed">
        <parent link="${rarm_tip_link}" />
        <child link="${rhand_base_link}" />
        <origin xyz="0 0 -0.004" rpy="0 0 0 " />
    </joint>

    <xacro:trx_s_sim prefix="r" type="right" base_link="${rhand_base_link}"/>

    <xacro:typeg-larm base_link="${larm_base_link}" tip_link="${larm_tip_link}"/>

    <joint name="body_to_larm_connector" type="fixed">
        <parent link="body_link" />
        <child link="${larm_base_link}" />
        <origin xyz="-0.018 0.134202 0.251871" rpy="0 0 0" />
    </joint>

    <joint name="l_wrist_to_hand_connector" type="fixed">
        <parent link="${larm_tip_link}" />
        <child link="${lhand_base_link}" />
        <origin xyz="0 0 -0.004" rpy="0 0 0 " />
    </joint>


    <xacro:trx_s_sim prefix="l" type="left" base_link="${lhand_base_link}"/>


    <!-- 胸部カメラ(実機 RealSense D415 相当)のシミュレーション。
         実機では realsense2_camera ドライバが画像を配信するが、シムには
         カメラが無く ArUco 検出が動かないため、ここでセンサを定義する。
         typeg_body.xacro は実機URDFと共用のため、シム専用のこちらに置く。

         chest_camera_link は ROS の光学系規約(Z前方/X右/Y下)ではなく
         リンク系(X前方/Y左/Z上)なので、そのままセンサを付けると画像が
         90度回転して ArUco の姿勢推定がおかしくなる。
         規約変換用に chest_camera_optical_frame を挟む。 -->
    <link name="chest_camera_optical_frame" />

    <!-- ROS の画像は光学系規約(Z前方/X右/Y下)の frame_id を期待するため、
         その変換用フレームを用意する。gz_frame_id にこれを指定することで
         配信される画像の frame_id が光学系になり、ArUco の姿勢推定結果を
         そのまま TF で扱える。
         注意: このフレームに <sensor> を付けてはいけない。
         SDF のカメラは自フレームの +X 方向を向く仕様で、光学系の回転を
         重ねると二重回転になり、あらぬ方向を向く(実際に床と壁しか映らなかった)。
         センサ本体は回転を掛けない chest_camera_link 側に付ける。 -->
    <joint name="chest_camera_link_to_optical_frame" type="fixed">
        <parent link="chest_camera_link" />
        <child link="chest_camera_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>

    <gazebo reference="chest_camera_link">
        <sensor name="chest_camera" type="camera">
            <topic>chest_camera/image_raw</topic>
            <gz_frame_id>chest_camera_optical_frame</gz_frame_id>
            <update_rate>30</update_rate>
            <always_on>true</always_on>
            <visualize>false</visualize>
            <camera>
                <!-- D415 カラーの水平画角 69.4deg = 1.211 rad -->
                <horizontal_fov>1.211</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                    <format>R8G8B8</format>
                </image>
                <!-- カメラ原点が胸部メッシュのすぐ内側にあるため、near が
                     小さすぎると自機の筐体が写り込む。0.15m で筐体を除去しつつ、
                     お盆(約0.46m先)は欠けない。 -->
                <clip>
                    <near>0.15</near>
                    <far>10.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <xacro:include filename="$(find noid_lifter_mover)/model/noid_lifter_mover_sim.ros2_control.xacro" />
    <xacro:noid_lifter_mover_sim_ros2_control name="noid_lifter_mover_sim" />

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controller_settings)</parameters>
            <!-- 位置制御のPゲイン(デフォルト0.1)。重力による腕の垂れと
                 姿勢再現性のばらつき(±3cm)を抑えるため高め。発振したら下げる -->
            <position_proportional_gain>1.0</position_proportional_gain>
        </plugin>
        <!-- メカナム移動の運動学的駆動: /model/<name>/cmd_vel (機体座標系Twist) -->
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        </plugin>
    </gazebo>
</robot>
