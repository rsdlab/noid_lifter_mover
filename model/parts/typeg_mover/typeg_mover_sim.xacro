<?xml version="1.0" encoding="utf-8"?>

<!-- Gazebo simulation variant of typeg_mover.xacro:
     - wheel joints are continuous (spun by mecanum_drive_controller for odometry;
       base motion itself is driven kinematically by the VelocityControl plugin)
     - wheel collisions are frictionless spheres
     - inertial properties added
     - gpu_lidar sensor on wheels_base_laser_link -->
<root xmlns:xacro="http://ros.org/wiki/xacro">
   <xacro:arg name="parts_dir" default="../" />

   <xacro:include filename="$(arg parts_dir)/xacro_common.xacro"/>

   <xacro:property
      name="wheel_radius"
      value="0.075" />

   <xacro:macro
      name="sim-mecanum-wheel"
      params="joint_name link_name origin_xyz">

      <joint name="${joint_name}" type="continuous">
         <axis xyz="0 1 0" />
         <parent link="wheel_base_link" />
         <child link="${link_name}" />
         <origin xyz="${origin_xyz}" rpy="0 0 0" />
         <limit effort="20" velocity="20" />
         <dynamics damping="0.1" friction="0.0" />
      </joint>

      <link name="${link_name}">
         <visual>
            <origin xyz="0 0 0" rpy="${-pi/2} 0 0" />
            <geometry>
               <mesh filename="file://$(arg parts_dir)/typeg_mover/$(arg mesh_visual)/wheels_mecanum.dae" />
            </geometry>
         </visual>
         <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
               <sphere radius="${wheel_radius}" />
            </geometry>
         </collision>
         <inertial>
            <mass value="2.0" />
            <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0045" iyz="0" izz="0.0045" />
         </inertial>
      </link>

      <!-- ベースはVelocityControlプラグインで運動学的に駆動するため
           ホイールは摩擦ゼロで空転させる(オドメトリ計算用) -->
      <gazebo reference="${link_name}">
         <mu1>0.0</mu1>
         <mu2>0.0</mu2>
      </gazebo>

   </xacro:macro>

   <xacro:macro
      name="typeg-mover-sim"
      params="base_link top_link">

      <link name="${base_link}" />

      <xacro:armjoint
         joint_name="base_link_to_wheel_base_link_connector"
         type="fixed"
         parent="${base_link}"
         child="wheel_base_link"
         joint_origin_xyz="0 0 ${wheel_radius}"
         joint_origin_rpy="0 0 0" />

      <xacro:armlink
         model_type="typeg_mover"
         link_name="wheel_base_link"
         mesh_name="wheels_base"
         base_origin_xyz="0 0 0"
         base_origin_rpy="0 0 0"
         mass="20.0"
         ixx="0.3" iyy="0.4" izz="0.5" />

      <xacro:armjoint
         joint_name="wheels_body_to_top_connector"
         type="fixed"
         parent="wheel_base_link"
         child="${top_link}"
         joint_origin_xyz="0.0 0.0 0.087"
         joint_origin_rpy="0 0 0" />

      <xacro:armlink
         model_type="typeg_mover"
         link_name="${top_link}"
         mesh_name="wheels_top"
         base_origin_xyz="0 0 0"
         base_origin_rpy="0 0 0"
         mass="5.0"
         ixx="0.1" iyy="0.1" izz="0.15" />

      <!-- ホイール -->
      <xacro:sim-mecanum-wheel
         joint_name="wheel_front_left"
         link_name="wheels_front_left_mecanum"
         origin_xyz="0.241 0.194759 0" />

      <xacro:sim-mecanum-wheel
         joint_name="wheel_front_right"
         link_name="wheels_front_right_mecanum"
         origin_xyz="0.241 -0.194759 0" />

      <xacro:sim-mecanum-wheel
         joint_name="wheel_rear_left"
         link_name="wheels_rear_left_mecanum"
         origin_xyz="-0.241 0.194759 0" />

      <xacro:sim-mecanum-wheel
         joint_name="wheel_rear_right"
         link_name="wheels_rear_right_mecanum"
         origin_xyz="-0.241 -0.194759 0" />

      <!-- LIDAR -->
      <xacro:armjoint
         joint_name="wheels_body_to_base_laser_connector"
         type="fixed"
         parent="wheel_base_link"
         child="wheels_base_laser_link"
         joint_origin_xyz="0.308 0 0.1014"
         joint_origin_rpy="0 0 0" />

      <xacro:armlink
         model_type="typeg_mover"
         link_name="wheels_base_laser_link"
         mesh_name="wheels_urg"
         base_origin_xyz="0 0 0"
         base_origin_rpy="0 0 0"
         mass="0.2"
         ixx="0.001" iyy="0.001" izz="0.001" />

      <gazebo reference="wheels_base_laser_link">
         <sensor name="front_lidar" type="gpu_lidar">
            <topic>scan</topic>
            <gz_frame_id>wheels_base_laser_link</gz_frame_id>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>false</visualize>
            <lidar>
               <scan>
                  <horizontal>
                     <samples>360</samples>
                     <resolution>1</resolution>
                     <min_angle>-2.356194</min_angle>
                     <max_angle>2.356194</max_angle>
                  </horizontal>
               </scan>
               <range>
                  <min>0.06</min>
                  <max>20.0</max>
                  <resolution>0.01</resolution>
               </range>
            </lidar>
         </sensor>
      </gazebo>

      <!-- カメラ -->
      <xacro:armjoint
         joint_name="wheel_base_link_to_front_camera_base_link"
         type="fixed"
         parent="wheel_base_link"
         child="front_camera_base_link"
         joint_origin_xyz="0.31815 0 0.0185"
         joint_origin_rpy="0 0 0" />

      <link name="front_camera_base_link" />

      <xacro:armjoint
         joint_name="front_camera_base_link_to_front_camera_link"
         type="fixed"
         parent="front_camera_base_link"
         child="front_camera_link"
         joint_origin_xyz="0 0.0175 0.0125"
         joint_origin_rpy="0 0 0" />
      <link name="front_camera_link" />

      <xacro:armjoint
         joint_name="front_camera_link_to_front_camera_right_ir_link"
         type="fixed"
         parent="front_camera_link"
         child="front_camera_right_ir_frame"
         joint_origin_xyz="0 -0.05 0"
         joint_origin_rpy="0 0 0" />
      <link name="front_camera_right_ir_frame" />

      <xacro:armjoint
         joint_name="wheel_base_link_to_rear_camera_base_link"
         type="fixed"
         parent="wheel_base_link"
         child="rear_camera_base_link"
         joint_origin_xyz="-0.31815 0 0.0185"
         joint_origin_rpy="0 0 ${pi}" />
      <link name="rear_camera_base_link" />

      <xacro:armjoint
         joint_name="rear_camera_base_link_to_rear_camera_link"
         type="fixed"
         parent="rear_camera_base_link"
         child="rear_camera_link"
         joint_origin_xyz="0 0.0175 0.0125"
         joint_origin_rpy="0 0 0" />
      <link name="rear_camera_link" />

      <xacro:armjoint
         joint_name="rear_camera_link_to_rear_camera_right_ir_link"
         type="fixed"
         parent="rear_camera_link"
         child="rear_camera_right_ir_frame"
         joint_origin_xyz="0 -0.05 0"
         joint_origin_rpy="0 0 0" />
      <link name="rear_camera_right_ir_frame" />

   </xacro:macro>
</root>
